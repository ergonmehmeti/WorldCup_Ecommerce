# ============================================
# World Cup E-commerce Backend Configuration
# ============================================
# 🔒 All real values (hosts, IPs, credentials, IDs) are hidden.
#    Copy this file to .env and fill in your own values.

# Server
PORT=5001
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worldcup_ecommerce
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Secret (change this to a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Email (SMTP) - For sending verification codes & OTT credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="App Name <noreply@example.com>"

# Bank Payment Gateway — NestPay (3D Pay Hosting)
# 🔒 BANK GATEWAY CALL — real gateway URLs & merchant credentials hidden
TEB_CLIENT_ID=your_client_id
TEB_STORE_KEY=your_store_key
TEB_3D_GATE_URL=https://bank-gateway.example.com/fim/est3dgate
TEB_API_URL=https://bank-gateway.example.com/fim/api
TEB_API_USERNAME=your_api_username
TEB_API_PASSWORD=your_api_password
TEB_STORE_TYPE=3D_PAY_HOSTING
TEB_CURRENCY=978

# Backend URL (for bank callback URLs — must be publicly accessible in production)
BACKEND_URL=http://localhost:5001

# OTT API — subscriber provisioning
# 🔒 OTT API CALL — real host, credentials and package IDs hidden
OTT_API_URL=https://ott-api.example.com/api/v1
OTT_USERNAME=your_ott_username
OTT_PASSWORD=your_ott_password
OTT_PACKAGE_IDS_PERSONAL=1,2,3
OTT_PACKAGE_IDS_BUSINESS=1,3,4

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Subscription Price (in EUR cents)
SUBSCRIPTION_PRICE=2000
SUBSCRIPTION_CURRENCY=EUR

# Gift Email (CSV export to customer care)
VALA_GIFT_EMAIL=customer-care@example.com
VALA_GIFT_HEARTBEAT_EMAIL=admin@example.com
VALA_GIFT_LOG_PATH=/var/log/vala-gifts
VALA_GIFT_ENABLED=true

# Ops scripts (backend/scripts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
REPORT_RECIPIENT=reports@example.com
REPORT_RECIPIENTS=reports@example.com,team@example.com

# OSC / Recharge SOAP Integration (automatic gifting for prepaid numbers)
# 🔒 OSC IP CALL — internal SOAP endpoint, credentials and product codes hidden
OSC_SOAP_URL=http://osc-internal.example.com/soap
OSC_SOAP_ACTION=your_soap_action
OSC_USERNAME=your_osc_username
OSC_PIN=your_pin_here
OSC_PIN_SALT=your_pin_salt
OSC_TERMINAL_ID=your_terminal_id
OSC_NETWORK_OPERATOR_ID=1
OSC_SEQUENCE_NUMBER=1
OSC_ORDER_ID=your_order_id
OSC_AMOUNT=0.00
OSC_GIFT_ENABLED=false
